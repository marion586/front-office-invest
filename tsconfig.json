{
    "compilerOptions": {
        "target": "esnext",
        "useDefineForClassFields": true,
        "module": "esnext",
        "moduleResolution": "node",
        "strict": true,
        "jsx": "preserve",
        "sourceMap": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "lib": ["esnext", "dom"],
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                // / to begin with.
                "src/*"
            ],
            "*": ["types/*"]
        },
        "types": ["vite/client", "leaflet", "geojson"],
        "allowJs": true,
        "checkJs": false // Optional: Prevent TypeScript from checking JavaScript files for type errors
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "types"
    ]
    // "references": [{ "path": "./tsconfig.node.json" }]
}
